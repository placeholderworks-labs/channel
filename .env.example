# PlaceholderWorks channel service: bootstrap values only.
# Every voice setting (channels, STT, TTS, turn-taking, brain, ingestion, limits)
# lives in the database and is edited in Voice Studio → Settings. On first boot
# with an empty database the registry defaults are seeded; set API keys and the
# rest from the dashboard. Only what is needed before the database is reachable
# belongs here.

# Settings database
USE_DB=true
DATABASE_URL=postgresql://user:password@localhost:5432/pw_channel
# The same database as seen from inside the container (docker-compose.yml)
DOCKER_DATABASE_URL=postgresql://user:password@host.docker.internal:5432/pw_channel

# Dashboard access
DASHBOARD_ENABLED=true
# Signs dashboard sessions; changing it signs everyone out
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_HOURS=168
# Created as the first super admin on a fresh database
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_ADMIN_NAME=
# The link put in invite and password-reset emails
DASHBOARD_PUBLIC_URL=http://localhost:8420/dashboard

# Dashboard email (invites, password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=

# Process (read once at start)
HOST=0.0.0.0
PORT=8420
LOG_LEVEL=INFO
LOG_COLOR=auto
# Bearer token for /internal/logs; a signed-in dashboard user with logs.view also works
INTERNAL_LOG_TOKEN=

# Channel platform
PW_CONFIG=
ENABLED_CHANNELS=voice,whatsapp,email
TELEPHONY_PROVIDER=acefone
CLIENT_COUNTRY=IN
CLIENT_TIMEZONE=Asia/Kolkata
ALLOWED_COUNTRIES=IN
CONTACT_HOURS_START=
CONTACT_HOURS_END=
MESSAGE_HOURS_START=
MESSAGE_HOURS_END=
MAX_CONTACTS_PER_DAY=6
DND_PROVIDER=none
ADAPTER_TIMEOUT_SECS=5
WORKER_POLL_SECS=2
WORKER_BATCH=20
CHANNEL_PUBLIC_URL=http://localhost:8420
EMAIL_LINK_SECRET=

# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BOT_PHONE_NUMBER=
WEBHOOK_VERIFY_TOKEN=
ADMIN_SECRET=
VOICEBOT_API_SECRET=
CHAT_SERVICE_ENDPOINT=http://localhost:8010/api/pw-ai-service/chat
REDIS_HOST=localhost
REDIS_PORT=6379
KARIX_SENDER_NUMBERS=
NOWONEXTEL_SENDER_NUMBERS=
